# ==========================================
# VISITOR PASS MANAGEMENT SYSTEM - CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/visitor_pass_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_encryption_key_here_min_32_chars

# Client Application URL (For CORS & email links)
CLIENT_URL=http://localhost:5173

# Email Notifications (Optional - Nodemailer SMTP)
# If left blank, system automatically uses Ethereal test account with instant preview URLs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Visitor Pass System" <noreply@visitorpass.com>

# SMS Notifications (Optional - Twilio Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
